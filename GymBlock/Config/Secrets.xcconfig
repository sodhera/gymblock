// Committed. Declares empty defaults so the project builds with zero setup,
// then pulls in the gitignored Config.xcconfig (copy Config.xcconfig.example)
// to override with real values. Empty keys mean "dev mode":
//   SUPABASE_*          empty → auth/friends disabled (DEBUG builds may skip sign-in)
//   REVENUECAT_API_KEY  empty → paywall stands down, app runs unlocked
// See docs/development.md.
SUPABASE_URL =
SUPABASE_ANON_KEY =
REVENUECAT_API_KEY =

#include? "Config.xcconfig"
