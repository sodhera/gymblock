// Copy to Config.xcconfig (same folder, gitignored) and fill in real values,
// or let scripts/setup-supabase.sh write it. See docs/setup-checklist.md.
// xcconfig treats "//" as a comment, so URLs need the $() trick below.
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key
REVENUECAT_API_KEY = appl_your_public_key
