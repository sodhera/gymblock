// Public client keys, injected into Info.plist at build time. Nothing here is secret; secrets
// (RevenueCat secret keys, Supabase service keys) never ship in the app.
//
// RevenueCat project "GymBlock" (65ed1e99). Every build uses the App Store app's key (since 10 Oct 2026; the
// Test Store key was removed). Debug purchases go through Apple's sandbox: sign in a Sandbox Apple Account
// on the device (Settings → Developer → Sandbox Apple Account).
REVENUECAT_API_KEY = appl_mjqLkRAGrYhUnkvdiPOVsbBeyMU

// PostHog product analytics (GymPostHog.swift): the project API key (phc_…, write-only, client-safe)
// and the host without its scheme, since xcconfig reads "//" as a comment: us.i.posthog.com (US cloud,
// the default when empty) or eu.i.posthog.com. Empty key: nothing is sent to PostHog.
POSTHOG_API_KEY =
POSTHOG_HOST =

// TikTok ad attribution (GymTikTok.swift). APPLE_APP_ID is the numeric App Store id, TIKTOK_APP_ID the
// app's id in TikTok Events Manager, and the access token authorizes reporting. Unlike the keys above,
// the token is not client-safe by design; it ships in the binary because the SDK needs it, so treat it
// as rotatable and keep it out of git: real values go in the gitignored Secrets.local.xcconfig.
// Empty: TikTok is never initialized.
APPLE_APP_ID =
TIKTOK_APP_ID =
TIKTOK_ACCESS_TOKEN =

#include? "Secrets.local.xcconfig"
